      "lines": [
        {
          "id": "hook",
          "text": "What if you need to store fifty test scores?",
          "cues": {
            "fifty": "fifty"
          }
        },
        {
          "id": "welcome",
          "text": "Don't make fifty variables! Welcome to Day 5: arrays.",
          "cues": {
            "fiftyVars": "variables",
            "day5": "Day 5",
            "arrays": "arrays"
          }
        }
      ]
    },
    {
      "id": "life",
      "lines": [
        {
          "id": "life",
          "text": "A variable is one box. An array is a row of boxes with one name.",
          "cues": {
            "oneBox": "one box",
            "row": "row",
            "oneName": "one name"
          }
        },
        {
          "id": "index",
          "text": "Each box gets a number, its index, starting at zero!",
          "cues": {
            "number": "number",
            "indexWord": "index",
            "zero": "zero"
          }
        }
      ]
    },
    {
      "id": "code",
      "lines": [
        {
          "id": "decl",
          "text": "In C#, int with square brackets is an array of whole numbers.",
          "cues": {
            "intArr": "int",
            "brackets": "square"
          }
        },
        {
          "id": "values",
          "text": "The values go inside curly braces.",
          "cues": {
            "braces": "curly"
          }
        },
        {
          "id": "access",
          "text": "To read one, write its index in square brackets.",
          "cues": {
            "index": "index"
          }
        },
        {
          "id": "first",
          "text": "Zero gets the first one. Two gets the third.",
          "cues": {
            "zeroFirst": "Zero",
            "twoThird": "Two"
          }
        },
        {
          "id": "length",
          "text": "And Length tells you how many.",
          "cues": {
            "length": "Length",
            "howMany": "how many"
          }
        },
        {
          "id": "run",
          "text": "Run it: 90, 82, and 3!",
          "cues": {
            "n1": "90",
            "n2": "82",
            "n3": "3"
          }
        }
      ]
    },
    {
      "id": "recap",
      "lines": [
        {
          "id": "recap",
          "text": "So remember: one name, many values, and the index starts at zero.",
          "cues": {
